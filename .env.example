# Copy to .env.local; never commit real credentials.
# Development fixture only: no network inference.
AI_PROVIDER=mock
HACKATHON_FINAL=false

# Final: AI_PROVIDER=nebius and HACKATHON_FINAL=true.
# Obtain the key after program approval. All values are server-side only.
NEBIUS_API_KEY=
# Select an enabled model from your account; availability is not assumed.
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Database/auth owner selects concrete provider and env names.
# DATABASE_URL=
